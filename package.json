{
  "name": "team-water",
  "version": "0.1.0",
  "private": true,
  "description": "Team Water — Faisalabad Water Finder: find, compare and report on water filtration plants.",
  "main": "server/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch server/index.js",
    "setup": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/setup.js",
    "import:xlsx": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/import-xlsx.js",
    "admin:create": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/create-admin.js",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"test/**/*.test.js\"",
    "test:e2e": "node --disable-warning=ExperimentalWarning test/e2e/run.js"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/gochi-hand": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-nastaliq-urdu": "^5.3.0",
    "animejs": "^4.5.0",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "leaflet": "1.9",
    "motion": "^13.4.4",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "playwright-core": "^1.56.1"
  }
}
