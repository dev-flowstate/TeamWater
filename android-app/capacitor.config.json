{
  "appId": "org.teamwater.app",
  "appName": "Team Water",
  "webDir": "www",
  "server": {
    "url": "https://team-water.vercel.app",
    "androidScheme": "https",
    "errorPath": "offline.html",
    "allowNavigation": ["team-water.vercel.app"]
  },
  "android": {
    "backgroundColor": "#f6f1e7"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#f6f1e7",
      "showSpinner": false
    },
    "StatusBar": {
      "backgroundColor": "#f6f1e7",
      "style": "LIGHT",
      "overlaysWebView": false
    }
  }
}
