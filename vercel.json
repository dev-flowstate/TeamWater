{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "memory": 1024,
      "includeFiles": "{server/**,scripts/**,data/source/**,data/gazetteer/**,public/**,node_modules/leaflet/dist/**,node_modules/@fontsource/**,node_modules/animejs/dist/bundles/**,node_modules/motion/dist/**}"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index.js" }]
}
